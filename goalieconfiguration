"""
Goalie Controller  –  MicroPython / Raspberry Pi Pico 2
========================================================
Moves a 1×3 inch goalpost carriage continuously back and forth.
Position is tracked by the AS5600 encoder (same knob/wiring as rover).

Wiring
  AS5600   SDA → GP4   SCL → GP5   (I2C0)
  Motor    IN1 → GP10  IN2 → GP11
  OC pin       → GP15  (overcurrent, active-low, PULL_UP)

Physical constants
  Wheel radius : 24 mm  (0.024 m)
  Travel       : 3 inches = 76.2 mm = 0.0762 m
  
  The AS5600 measures how far the drive wheel has turned.
  When cumulative arc length reaches TRAVEL_M the carriage
  has moved 3 inches — reverse and go back.
"""

from machine import Pin, PWM, Timer, I2C
import time
import math

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG
# ─────────────────────────────────────────────────────────────────────────────
WHEEL_RADIUS_M  = 0.024          # 24 mm wheel radius
TRAVEL_M        = 0.0762         # 3 inches in metres
PATROL_SPEED    = 8000           # PWM duty [0–65535] — tune for your motor
MAX_SPEED       = 65535
OFF             = 65535          # motor off duty (active-low driver)

# I2C / AS5600
I2C_SDA         = 4
I2C_SCL         = 5
AS5600_ADDR     = 0x36
_REG_STATUS     = 0x0B
_REG_ANGLE_H    = 0x0C
_MD_BIT         = 1 << 5
_TWO_PI         = 2.0 * math.pi

# Motor pins
MOTOR_IN1       = 10
MOTOR_IN2       = 11

# Overcurrent pin
OC_PIN          = 15

# ─────────────────────────────────────────────────────────────────────────────
# AS5600
# ─────────────────────────────────────────────────────────────────────────────
i2c = I2C(0, sda=Pin(I2C_SDA), scl=Pin(I2C_SCL), freq=400_000)


def _as5600_angle() -> float:
    """Return current angle in radians [0, 2π)."""
    i2c.writeto(AS5600_ADDR, bytes([_REG_ANGLE_H]))
    d = i2c.readfrom(AS5600_ADDR, 2)
    raw = ((d[0] & 0x0F) << 8) | d[1]
    return (raw / 4096.0) * _TWO_PI


def _wait_for_magnet():
    print("Waiting for magnet", end="")
    while True:
        i2c.writeto(AS5600_ADDR, bytes([_REG_STATUS]))
        if i2c.readfrom(AS5600_ADDR, 1)[0] & _MD_BIT:
            print(" — found!")
            return
        print(".", end="")
        time.sleep_ms(250)


class Odometer:
    """Tracks signed cumulative distance (m) from the AS5600, wrap-safe."""
    def __init__(self):
        self._prev  = None
        self._cumul = 0.0       # cumulative radians

    def reset(self):
        self._prev  = None
        self._cumul = 0.0

    def update(self) -> float:
        angle = _as5600_angle()
        if self._prev is None:
            self._prev = angle
            return 0.0
        delta = angle - self._prev
        if delta >  math.pi: delta -= _TWO_PI
        if delta < -math.pi: delta += _TWO_PI
        self._cumul += delta
        self._prev   = angle
        return self._cumul * WHEEL_RADIUS_M   # metres, signed

    @property
    def distance_m(self) -> float:
        return self._cumul * WHEEL_RADIUS_M


# ─────────────────────────────────────────────────────────────────────────────
# MOTOR DRIVER  (kept from your original, single motor only)
# ─────────────────────────────────────────────────────────────────────────────
class MotorDriver:
    def __init__(self, in1: int, in2: int):
        self.input1 = PWM(Pin(in1, Pin.OUT))
        self.input1.freq(20000)
        self.input1.duty_u16(OFF)
        self.input2 = PWM(Pin(in2, Pin.OUT))
        self.input2.freq(20000)
        self.input2.duty_u16(OFF)

    def forward(self, speed: int = PATROL_SPEED):
        self.input1.duty_u16(speed)
        self.input2.duty_u16(OFF)

    def backward(self, speed: int = PATROL_SPEED):
        self.input2.duty_u16(speed)
        self.input1.duty_u16(OFF)

    def stop(self):
        self.input1.duty_u16(OFF)
        self.input2.duty_u16(OFF)


# ─────────────────────────────────────────────────────────────────────────────
# OVERCURRENT PROTECTION  (straight from your original logic)
# ─────────────────────────────────────────────────────────────────────────────
class OvercurrentGuard:
    def __init__(self, pin: int, motor: MotorDriver):
        self._motor          = motor
        self.triggered       = False
        self._debouncing     = False
        self._oc_pin         = Pin(pin, Pin.IN, Pin.PULL_UP)
        self._debounce_timer = Timer()
        self._reset_timer    = Timer()
        self._oc_pin.irq(trigger=Pin.IRQ_FALLING, handler=self._isr)

    def _isr(self, pin):
        if self._debouncing or self.triggered:
            return
        self._debouncing = True
        self._debounce_timer.init(
            mode=Timer.ONE_SHOT, period=500,
            callback=self._confirm
        )

    def _confirm(self, t):
        if not self._oc_pin.value():        # still low → real fault
            self.triggered   = True
            self._debouncing = False
            self._motor.stop()
            print("OC triggered — motor stopped")
            self._reset_timer.init(
                mode=Timer.ONE_SHOT, period=500,
                callback=self._reset
            )
        else:
            self._debouncing = False        # glitch — ignore

    def _reset(self, t):
        self.triggered = False
        print("OC cleared — resuming")


# ─────────────────────────────────────────────────────────────────────────────
# GOALIE  —  the only logic that matters
# ─────────────────────────────────────────────────────────────────────────────
class Goalie:
    """
    Patrols back and forth across exactly 3 inches (TRAVEL_M).

    State machine — two states:
      FORWARD  : drive until odometer >= +TRAVEL_M, then flip
      BACKWARD : drive until odometer <= 0, then flip
    """
    _FWD = 1
    _BWD = -1

    def __init__(self):
        self.motor  = MotorDriver(MOTOR_IN1, MOTOR_IN2)
        self.oc     = OvercurrentGuard(OC_PIN, self.motor)
        self.odo    = Odometer()
        self._dir   = self._FWD

        _wait_for_magnet()
        self.odo.reset()
        print(f"Goalie ready. Travel = {TRAVEL_M*1000:.1f} mm  "
              f"({TRAVEL_M/0.0254:.1f} in)")

    def _flip(self):
        """Reverse direction and reset odometer origin to current position."""
        self.odo.reset()
        self._dir = -self._dir

    def tick(self):
        """Call as fast as possible in the main loop."""
        if self.oc.triggered:
            return                          # motor already stopped by OC guard

        dist = self.odo.update()

        if self._dir == self._FWD:
            if dist >= TRAVEL_M:
                self._flip()
                self.motor.backward(PATROL_SPEED)
                print(f"→ reversed (fwd end)  dist={dist*1000:.1f}mm")
            else:
                self.motor.forward(PATROL_SPEED)

        else:  # _BWD
            if dist <= -TRAVEL_M:
                self._flip()
                self.motor.forward(PATROL_SPEED)
                print(f"← reversed (bwd end)  dist={dist*1000:.1f}mm")
            else:
                self.motor.backward(PATROL_SPEED)


# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────
goalie = Goalie()

while True:
    goalie.tick()
    time.sleep_ms(5)        # 200 Hz loop — plenty for 3-inch travel
